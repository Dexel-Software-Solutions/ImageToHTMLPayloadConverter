// app.rc - resource script
// Embeds icon.ico as the application icon (resource ID 1, matches
// MAKEINTRESOURCEW(1) used in main.c), plus version information.

1 ICON "icon.ico"

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Dexel Software Solutions"
            VALUE "FileDescription", "ImageToHTML Payload Converter"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ImageToHTMLPayloadConverter"
            VALUE "LegalCopyright", "(C) 2026 Dexel Software Solutions. All rights reserved."
            VALUE "OriginalFilename", "ImageToHTMLPayloadConverter.exe"
            VALUE "ProductName", "ImageToHTML Payload Converter"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "Developer", "Demiyan Dissanayake"
            VALUE "Support", "https://github.com/dexel-software-solutions"
            VALUE "Contact", "demiyandissanayake@gmail.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
